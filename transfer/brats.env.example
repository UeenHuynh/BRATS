# Copy this file on the remote machine, replace the paths, then source it.
export PROJECT_ROOT=/path/to/BRATS/code/brats-research
export BRATS_DATASET_ROOT=/path/to/BRATS/datasets/preprocessed
export BRATS_OUTPUT_BASE=/path/to/BRATS/experiments/unet
export BRATS_VENV_DIR=/path/to/BRATS/.venv-train

# Optional cluster-specific locations.
export BRATS_UV_CACHE_DIR=/path/to/scratch/brats-uv-cache
